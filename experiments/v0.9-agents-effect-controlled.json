{
  "description": "Replicacion controlada del efecto de AGENTS.md sin fuentes externas",
  "stop_on_failure": true,
  "runs": [
    {
      "condition": "A_NO_AGENTS",
      "repetitions": 5,
      "workspace": "full",
      "agents": "none",
      "prompt": "agents_effect_controlled.txt"
    },
    {
      "condition": "B_WITH_AGENTS",
      "repetitions": 5,
      "workspace": "full",
      "agents": "routed",
      "prompt": "agents_effect_controlled.txt"
    }
  ]
}
