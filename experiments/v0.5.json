{
  "description": "Comparacion sin/con AGENTS.md raiz en el entorno personal",
  "stop_on_failure": true,
  "runs": [
    {
      "condition": "A_NO_AGENTS",
      "repetitions": 5,
      "workspace": "full",
      "agents": "none",
      "prompt": "research_base.txt"
    },
    {
      "condition": "B_WITH_AGENTS",
      "repetitions": 5,
      "workspace": "full",
      "agents": "routed",
      "prompt": "research_base.txt"
    }
  ]
}
